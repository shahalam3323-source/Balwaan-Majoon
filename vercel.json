{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/990only", "destination": "/cod-oiloffer-checkout.html" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(css|js|webp|png|jpg|jpeg|svg|ico|webmanifest))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
